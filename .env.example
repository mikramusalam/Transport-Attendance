# ── REQUIRED ──────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local docker-compose default shown; if using a managed Postgres, paste
# the connection string it gives you here instead.
DATABASE_URL=postgresql://attendance:CHANGE_ME@localhost:5432/attendance

# Random long secret used to sign admin session cookies.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ── docker-compose only (Postgres container credentials) ────────────────
POSTGRES_USER=attendance
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=attendance

# ── OPTIONAL ──────────────────────────────────────────────────────────

# Port the Node server listens on (Caddy/Nginx proxies to this).
PORT=3000

# Where the self-hosted face-recognition model files live (see
# `npm run models:download`). Defaults to ./face-models if unset.
FACE_MODELS_DIR=./face-models

# Where enrolled reference photos are stored (auth-only access, never
# public). Defaults to ./enrollment-photos if unset.
ENROLLMENT_PHOTO_DIR=./enrollment-photos

# Where in-progress verification selfies are held before an attendance
# record is submitted. Defaults to ./pending-photos if unset.
PENDING_PHOTO_DIR=./pending-photos

# Where submitted verification selfies are kept during their retention
# window (default 3 days, configurable in admin Settings). Auto-cleaned by
# an hourly background job. Defaults to ./attendance-photos if unset.
ATTENDANCE_PHOTO_DIR=./attendance-photos

# ── First-admin seeding (only used by `npm run db:seed`) ────────────────
SEED_ADMIN_NAME=Fleet Administrator
SEED_ADMIN_EMAIL=owner@yourcompany.com
SEED_ADMIN_PASSWORD=Choose-A-Strong-Password-1!
SEED_COMPANY_NAME=Your Company Name
